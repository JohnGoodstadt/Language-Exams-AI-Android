    {
      "title": "Reflexive: two different cases",
      "sortorder": 2,
      "explanation": "If the reflexive pronoun is the only object it is often accusative; if a body part is the accusative object, the reflexive person is commonly dative.",
      "rule": "sich (Akk.) / sich (Dat.)",
      "entries": [
        {
          "header": "sich waschen / sich die Hände waschen",
          "kind": "comparison",
          "explanation": "Compare washing yourself with washing a body part. In first and second person, accusative and dative reflexive pronouns differ.",
          "pattern": "",
          "examples": [
            {
              "german": "Ich wasche mich.",
              "english": "I wash myself.",
              "focus": "mich",
              "note": "accusative",
              "key": "mich"
            },
            {
              "german": "Du wäschst dich.",
              "english": "You wash yourself.",
              "focus": "dich",
              "note": "accusative",
              "key": "dich"
            },
            {
              "german": "Der Mann wäscht sich.",
              "english": "The man washes himself.",
              "focus": "sich",
              "note": "accusative",
              "key": "sich"
            },
            {
              "german": "Die Frau wäscht sich.",
              "english": "The woman washes herself.",
              "focus": "sich",
              "note": "accusative",
              "key": "sich"
            },
            {
              "german": "Wir setzen uns.",
              "english": "We sit down.",
              "focus": "uns",
              "note": "accusative",
              "key": "uns"
            },
            {
              "german": "Ihr setzt euch.",
              "english": "You all sit down.",
              "focus": "euch",
              "note": "accusative",
              "key": "euch"
            },
            {
              "german": "Ich wasche mir die Hände.",
              "english": "I wash my hands.",
              "focus": "mir",
              "note": "dative",
              "key": "mir"
            },
            {
              "german": "Du wäschst dir die Hände.",
              "english": "You wash your hands.",
              "focus": "dir",
              "note": "dative",
              "key": "dir"
            }
          ]
        }
      ]
    },
    {
      "title": "Prepositions govern case",
      "sortorder": 3,
      "explanation": "A preposition can determine the case of a pronoun, independently of the verb. Some two-way prepositions depend on meaning (location versus direction).",
      "rule": "mit + Dat.; für + Akk.; warten auf + Akk.",
      "entries": [
        {
          "header": "mit / für / auf",
          "kind": "comparison",
          "explanation": "mit always takes dative, für always takes accusative; warten auf uses accusative as a fixed verb–preposition construction.",
          "pattern": "preposition + required case",
          "examples": [
            {
              "german": "Ich spreche mit ihm.",
              "english": "I speak with him.",
              "focus": "ihm",
              "note": "",
              "key": "ihm"
            },
            {
              "german": "Das Geschenk ist für ihn.",
              "english": "The gift is for him.",
              "focus": "ihn",
              "note": "",
              "key": "ihn"
            },
            {
              "german": "Ich warte auf ihn.",
              "english": "I wait for him.",
              "focus": "ihn",
              "note": "",
              "key": "ihn"
            }
          ]
        }
      ]
    },
