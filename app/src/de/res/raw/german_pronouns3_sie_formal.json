  "sheetname": "GermanPronouns3SieFormal",
  "title": "Sie (formal) — You (f)",
  "description": "Practise changing the object with Sie (formal): present, future and past.",
  "updatedDate": 20261015,
  "intro": "Every example uses Sie as its subject, meaning you (f) in this file. Sie is polite you and is always capitalized. Its verb forms match plural sie. The reflexive translations use yourself for one addressee; for several addressees, the same German sentences mean yourselves. Use sich when the subject is also the object or recipient. Keep the subject fixed and vary whom the subject sees or to whom the subject gives the book. Sehen takes an accusative object. Geben takes a dative recipient plus das Buch as the accusative thing. The highlighted key is the object or recipient. English labels: (s) singular, (p) plural, (f) formal.",
  "sections": [
    {
      "title": "Sie (formal) — changing the object",
      "sortorder": 1,
      "explanation": "Start with the present-tense accusative and dative lists, then compare the same object choices in Futur I and Perfekt. Short sentences omit final full stops.",
      "rule": "Sie sehen + Akkusativ | Sie geben + Dativ + das Buch",
      "entries": [
        {
          "header": "sehen — Präsens — present",
          "kind": "pattern",
          "explanation": "The subject and verb stay fixed. Change the accusative object.",
          "pattern": "Sie sehen + Akkusativ",
          "examples": [
            {
              "german": "Sie sehen mich",
              "english": "You (f) see me",
              "focus": "mich",
              "note": "",
              "key": "mich"
            },
            {
              "german": "Sie sehen dich",
              "english": "You (f) see you (s)",
              "focus": "dich",
              "note": "",
              "key": "dich"
            },
            {
              "german": "Sie sehen ihn",
              "english": "You (f) see him",
              "focus": "ihn",
              "note": "",
              "key": "ihn"
            },
            {
              "german": "Sie sehen sie",
              "english": "You (f) see her",
              "focus": "sie",
              "note": "Singular feminine: her.",
              "key": "sie"
            },
            {
              "german": "Sie sehen es",
              "english": "You (f) see it",
              "focus": "es",
              "note": "",
              "key": "es"
            },
            {
              "german": "Sie sehen uns",
              "english": "You (f) see us",
              "focus": "uns",
              "note": "",
              "key": "uns"
            },
            {
              "german": "Sie sehen euch",
              "english": "You (f) see you (p)",
              "focus": "euch",
              "note": "",
              "key": "euch"
            },
            {
              "german": "Sie sehen sie",
              "english": "You (f) see them",
              "focus": "sie",
              "note": "Plural: them. Same German spelling as her; context distinguishes the meaning.",
              "key": "sie"
            },
            {
              "german": "Sie sehen sich",
              "english": "You (f) see yourself",
              "focus": "sich",
              "note": "Reflexive reading: yourself. One formal addressee in this English translation; several addressees would be yourselves. Sich stays lowercase.",
              "key": "sich"
            }
          ]
        },
        {
          "header": "geben — Präsens — present",
          "kind": "pattern",
          "explanation": "The subject, verb and das Buch stay fixed. Change only the dative recipient. Ihm is translated as him here, but can also refer to a neuter noun.",
