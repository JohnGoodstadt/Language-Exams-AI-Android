  "sheetname": "GermanPronouns3Ich",
  "title": "ich — I",
  "description": "Practise changing the object with ich: present, future and past.",
  "updatedDate": 20261015,
  "intro": "Every example uses Ich as its subject, meaning I in this file. Mich/mir refer back to the subject in the self-reference rows. Seeing oneself can describe a mirror or photo. Keep the subject fixed and vary whom the subject sees or to whom the subject gives the book. Sehen takes an accusative object. Geben takes a dative recipient plus das Buch as the accusative thing. The highlighted key is the object or recipient. English labels: (s) singular, (p) plural, (f) formal.",
  "sections": [
    {
      "title": "ich — changing the object",
      "sortorder": 1,
      "explanation": "Start with the present-tense accusative and dative lists, then compare the same object choices in Futur I and Perfekt. Short sentences omit final full stops.",
      "rule": "Ich sehe + Akkusativ | Ich gebe + Dativ + das Buch",
      "entries": [
        {
          "header": "sehen — Präsens — present",
          "kind": "pattern",
          "explanation": "The subject and verb stay fixed. Change the accusative object.",
          "pattern": "Ich sehe + Akkusativ",
          "examples": [
            {
              "german": "Ich sehe mich",
              "english": "I see myself",
              "focus": "mich",
              "note": "Reflexive reading: myself.",
              "key": "mich"
            },
            {
              "german": "Ich sehe dich",
              "english": "I see you (s)",
              "focus": "dich",
              "note": "",
              "key": "dich"
            },
            {
              "german": "Ich sehe ihn",
              "english": "I see him",
              "focus": "ihn",
              "note": "",
              "key": "ihn"
            },
            {
              "german": "Ich sehe sie",
              "english": "I see her",
              "focus": "sie",
              "note": "Singular feminine: her.",
              "key": "sie"
            },
            {
              "german": "Ich sehe es",
              "english": "I see it",
              "focus": "es",
              "note": "",
              "key": "es"
            },
            {
              "german": "Ich sehe uns",
              "english": "I see us",
              "focus": "uns",
              "note": "",
              "key": "uns"
            },
            {
              "german": "Ich sehe euch",
              "english": "I see you (p)",
              "focus": "euch",
              "note": "",
              "key": "euch"
            },
            {
              "german": "Ich sehe sie",
              "english": "I see them",
              "focus": "sie",
              "note": "Plural: them. Same German spelling as her; context distinguishes the meaning.",
              "key": "sie"
            },
            {
              "german": "Ich sehe Sie",
              "english": "I see you (f)",
              "focus": "Sie",
              "note": "Formal object or recipient: always capitalized; one or more addressees.",
              "key": "Sie"
            }
          ]
        },
        {
          "header": "geben — Präsens — present",
          "kind": "pattern",
          "explanation": "The subject, verb and das Buch stay fixed. Change only the dative recipient. Ihm is translated as him here, but can also refer to a neuter noun.",
          "pattern": "Ich gebe + Dativ + das Buch",
          "examples": [
            {
              "german": "Ich gebe mir das Buch",
              "english": "I give myself the book",
              "focus": "mir",
              "note": "Reflexive reading: myself.",
              "key": "mir"
            },
            {
              "german": "Ich gebe dir das Buch",
              "english": "I give you (s) the book",
              "focus": "dir",
              "note": "",
              "key": "dir"
            },
            {
              "german": "Ich gebe ihm das Buch",
              "english": "I give him the book",
              "focus": "ihm",
              "note": "Masculine or neuter dative; translated him here.",
              "key": "ihm"
            },
            {
              "german": "Ich gebe ihr das Buch",
              "english": "I give her the book",
              "focus": "ihr",
              "note": "",
              "key": "ihr"
            },
            {
              "german": "Ich gebe uns das Buch",
              "english": "I give us the book",
              "focus": "uns",
              "note": "",
              "key": "uns"
            },
            {
              "german": "Ich gebe euch das Buch",
              "english": "I give you (p) the book",
              "focus": "euch",
              "note": "",
              "key": "euch"
            },
            {
              "german": "Ich gebe ihnen das Buch",
              "english": "I give them the book",
              "focus": "ihnen",
              "note": "",
              "key": "ihnen"
            },
            {
              "german": "Ich gebe Ihnen das Buch",
              "english": "I give you (f) the book",
              "focus": "Ihnen",
              "note": "Formal object or recipient: always capitalized; one or more addressees.",
              "key": "Ihnen"
            }
          ]
        },
        {
          "header": "sehen — Futur I — future",
          "kind": "pattern",
