{
  "location": 0,
  "sheetname": "GermanPronouns2Dative",
  "title": "Dative: Key Verbs",
  "updatedDate": 0,
  "fileformat": 8,
  "description": "Learn common dative verbs and the pronouns they require.",
  "intro": "Some common verbs require the dative even when English uses a direct object: antworten, helfen, danken, folgen, glauben, vertrauen, zuhören and gratulieren. Memorise each as verb + jemandem (dative).",
  "sections": [
    {
      "title": "Essential dative verbs",
      "sortorder": 1,
      "explanation": "The recipient/person associated with these verbs is expressed in the dative. Learn the entire construction, not just the translation.",
      "rule": "Verb + jemandem (dative)",
