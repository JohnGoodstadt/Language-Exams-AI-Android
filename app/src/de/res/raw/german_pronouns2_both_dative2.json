    {
      "title": "Dative pronouns",
      "sortorder": 2,
      "explanation": "The forms are mir, dir, ihm, ihr, ihm, uns, euch, ihnen, Ihnen. Masculine and neuter both use ihm.",
      "rule": "wem? (to whom? / for whom?)",
      "entries": [
        {
          "header": "helfen — changing the object",
          "kind": "comparison",
          "explanation": "Change the dative pronoun while keeping the verb construction.",
          "pattern": "helfen + Dativ",
          "examples": [
            {
              "german": "Die Frau hilft mir.",
              "english": "The woman helps me.",
              "focus": "mir",
              "note": "",
              "key": "mir"
            },
            {
              "german": "Der Mann hilft dir.",
              "english": "The man helps you.",
              "focus": "dir",
              "note": "",
              "key": "dir"
            },
            {
              "german": "Ich helfe ihm.",
              "english": "I help him.",
              "focus": "ihm",
              "note": "",
              "key": "ihm"
            },
            {
              "german": "Ich helfe ihr.",
              "english": "I help her.",
              "focus": "ihr",
              "note": "",
              "key": "ihr"
            },
            {
              "german": "Ich helfe dem Kind.",
              "english": "I help the child.",
              "focus": "dem Kind",
              "note": "",
              "key": "Ich"
            },
            {
              "german": "Sie hilft uns.",
              "english": "She helps us.",
              "focus": "uns",
              "note": "",
              "key": "uns"
            },
            {
              "german": "Ich helfe euch.",
              "english": "I help you all.",
              "focus": "euch",
              "note": "",
              "key": "euch"
            },
            {
              "german": "Wir helfen ihnen.",
              "english": "We help them.",
              "focus": "ihnen",
              "note": "",
              "key": "ihnen"
            },
            {
              "german": "Wir helfen Ihnen.",
              "english": "We help you (formal).",
              "focus": "Ihnen",
              "note": "",
              "key": "Ihnen"
            }
          ]
        }
      ]
    },
    {
      "title": "Belonging and reactions",
      "sortorder": 3,
      "explanation": "These dative constructions often reverse the English viewpoint: the German subject may be a thing and the dative marks the experiencer or owner.",
      "rule": "Thing + verb + dative person",
      "entries": [
        {
          "header": "gehören — to belong to",
          "kind": "pattern",
          "explanation": "The owned item is the nominative subject; its owner is dative.",
          "pattern": "Nominative thing + verb + dative person",
          "examples": [
            {
              "german": "Das Buch gehört ihm.",
              "english": "The book belongs to him.",
              "focus": "ihm",
              "note": "",
              "key": "ihm"
            },
            {
              "german": "Die Bücher gehören ihr.",
              "english": "The books belong to her.",
              "focus": "ihr",
              "note": "",
              "key": "ihr"
            }
          ]
        },
        {
          "header": "gefallen — to appeal to",
          "kind": "pattern",
          "explanation": "The thing that is pleasing is the subject; the person who likes it is dative.",
          "pattern": "Nominative thing + verb + dative person",
          "examples": [
            {
              "german": "Das gefällt mir.",
              "english": "I like that.",
              "focus": "mir",
              "note": "",
              "key": "mir"
            },
            {
              "german": "Die Bücher gefallen ihm.",
              "english": "He likes the books.",
              "focus": "ihm",
              "note": "",
              "key": "ihm"
            }
          ]
        },
        {
          "header": "fehlen — to be missing",
          "kind": "pattern",
          "explanation": "The absent person or thing is the subject; the person who misses them is dative.",
          "pattern": "Nominative thing + verb + dative person",
          "examples": [
            {
              "german": "Du fehlst mir.",
              "english": "I miss you.",
              "focus": "mir",
              "note": "",
              "key": "mir"
            },
            {
              "german": "Meine Freunde fehlen mir.",
              "english": "I miss my friends.",
              "focus": "mir",
              "note": "",
              "key": "mir"
            }
          ]
        },
        {
          "header": "passen — to suit or fit",
          "kind": "pattern",
          "explanation": "The item is the subject; the person it suits is dative.",
          "pattern": "Nominative thing + verb + dative person",
          "examples": [
            {
              "german": "Der Mantel passt ihm.",
              "english": "The coat fits him.",
              "focus": "ihm",
              "note": "",
              "key": "ihm"
            },
            {
              "german": "Die Schuhe passen ihr.",
              "english": "The shoes fit her.",
              "focus": "ihr",
              "note": "",
              "key": "ihr"
            }
          ]
        }
      ]
    },
