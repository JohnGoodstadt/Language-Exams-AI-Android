            { "case": "wir", "text": "seien", "gloss": "(that) we are" },
            { "case": "ihr", "text": "seiet", "gloss": "(that) you all are" },
            { "case": "sie", "text": "seien", "gloss": "(that) they / you (formal) are" }
          ],
          "sections": [],
          "note": "Used to report what someone said, especially in news and formal writing. sein is the one verb with a full, distinct Konjunktiv I."
        },
        {
          "id": "konjunktiv1-ex",
