  "title": "sein — to be",
  "updatedDate": 0,
  "categories": [
    {
      "id": "praesens",
      "label": "Präsens",
      "sortOrder": 1,
      "note": "Present tense — what is true now.",
      "patterns": [
        {
          "id": "praesens-how",
          "chip": "How it works",
          "subtitle": "sein in all six persons",
          "sortOrder": 1,
          "forms": [
            { "case": "ich", "text": "bin", "gloss": "I am" },
            { "case": "du", "text": "bist", "gloss": "you are" },
            { "case": "er", "text": "ist", "gloss": "he / she / it is" },
            { "case": "wir", "text": "sind", "gloss": "we are" },
            { "case": "ihr", "text": "seid", "gloss": "you all are" },
            { "case": "sie", "text": "sind", "gloss": "they / you (formal) are" }
          ],
          "sections": [],
          "note": "sein is completely irregular — there is no stem to add endings to, so learn these six forms by heart."
        },
        {
          "id": "praesens-ex",
          "chip": "Examples",
          "subtitle": "one sentence per person",
          "sortOrder": 2,
          "forms": [],
          "sections": [
            {
              "header": "Examples",
              "tone": "normal",
              "sentences": [
                { "text": "Ich bin heute sehr müde.", "green": ["bin"] },
                { "text": "Du bist ein guter Freund.", "green": ["bist"] },
                { "text": "Er ist noch nicht da.", "green": ["ist"] },
                { "text": "Wir sind am Wochenende zu Hause.", "green": ["sind"] },
                { "text": "Ihr seid schon fertig.", "green": ["seid"] },
                { "text": "Sie sind sehr nett.", "green": ["sind"] }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "praeteritum",
      "label": "Präteritum",
      "sortOrder": 2,
      "note": "Simple past — common in writing and for sein/haben in speech.",
      "patterns": [
        {
          "id": "praeteritum-how",
          "chip": "How it works",
          "subtitle": "sein in the simple past",
          "sortOrder": 1,
          "forms": [
            { "case": "ich", "text": "war", "gloss": "I was" },
            { "case": "du", "text": "warst", "gloss": "you were" },
            { "case": "er", "text": "war", "gloss": "he / she / it was" },
            { "case": "wir", "text": "waren", "gloss": "we were" },
            { "case": "ihr", "text": "wart", "gloss": "you all were" },
            { "case": "sie", "text": "waren", "gloss": "they / you (formal) were" }
          ],
          "sections": [],
          "note": "Irregular stem war-. Note ich and er are identical (both war), as always in the Präteritum."
        },
        {
          "id": "praeteritum-ex",
          "chip": "Examples",
          "subtitle": "one sentence per person",
          "sortOrder": 2,
          "forms": [],
