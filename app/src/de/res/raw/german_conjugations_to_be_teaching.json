            {
              "header": "Examples",
              "tone": "normal",
              "sentences": [
                { "text": "Gestern war ich krank.", "green": ["war"] },
                { "text": "Du warst gestern nicht hier.", "green": ["warst"] },
                { "text": "Er war letzte Woche in Berlin.", "green": ["war"] },
                { "text": "Wir waren im Kino.", "green": ["waren"] },
                { "text": "Ihr wart sehr laut.", "green": ["wart"] },
                { "text": "Sie waren pünktlich.", "green": ["waren"] }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "perfekt",
      "label": "Perfekt",
      "sortOrder": 3,
      "note": "Present perfect — the everyday past tense in spoken German.",
      "patterns": [
        {
          "id": "perfekt-how",
          "chip": "How it works",
          "subtitle": "helper (sein) + gewesen",
          "sortOrder": 1,
          "forms": [
            { "case": "ich", "text": "bin gewesen", "gloss": "I have been" },
            { "case": "du", "text": "bist gewesen", "gloss": "you have been" },
            { "case": "er", "text": "ist gewesen", "gloss": "he / she / it has been" },
            { "case": "wir", "text": "sind gewesen", "gloss": "we have been" },
            { "case": "ihr", "text": "seid gewesen", "gloss": "you all have been" },
            { "case": "sie", "text": "sind gewesen", "gloss": "they / you (formal) have been" }
          ],
          "sections": [],
          "note": "sein builds the Perfekt with sein (not haben). Only the helper changes for each person; the participle gewesen never changes and goes to the end."
        },
        {
          "id": "perfekt-ex",
          "chip": "Examples",
          "subtitle": "one sentence per person",
          "sortOrder": 2,
          "forms": [],
          "sections": [
            {
              "header": "Examples",
              "tone": "normal",
              "sentences": [
                { "text": "Ich bin noch nie in Rom gewesen.", "green": ["bin", "gewesen"] },
                { "text": "Du bist schon oft hier gewesen.", "green": ["bist", "gewesen"] },
                { "text": "Er ist gestern krank gewesen.", "green": ["ist", "gewesen"] },
                { "text": "Wir sind im Urlaub gewesen.", "green": ["sind", "gewesen"] },
                { "text": "Ihr seid sehr fleißig gewesen.", "green": ["seid", "gewesen"] },
                { "text": "Sie sind pünktlich gewesen.", "green": ["sind", "gewesen"] }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "plusquamperfekt",
      "label": "Plusquamperfekt",
      "sortOrder": 4,
      "note": "Past perfect — an action finished before another past moment (had been).",
      "patterns": [
        {
          "id": "plusquamperfekt-how",
          "chip": "How it works",
          "subtitle": "war + gewesen",
          "sortOrder": 1,
          "forms": [
            { "case": "ich", "text": "war gewesen", "gloss": "I had been" },
            { "case": "du", "text": "warst gewesen", "gloss": "you had been" },
            { "case": "er", "text": "war gewesen", "gloss": "he / she / it had been" },
            { "case": "wir", "text": "waren gewesen", "gloss": "we had been" },
            { "case": "ihr", "text": "wart gewesen", "gloss": "you all had been" },
            { "case": "sie", "text": "waren gewesen", "gloss": "they / you (formal) had been" }
          ],
          "sections": [],
          "note": "Like the Perfekt, but the helper is in the Präteritum (war instead of bin). Use it for the 'earlier' of two past events."
        },
        {
          "id": "plusquamperfekt-ex",
          "chip": "Examples",
          "subtitle": "one sentence per person",
          "sortOrder": 2,
          "forms": [],
          "sections": [
            {
              "header": "Examples",
              "tone": "normal",
              "sentences": [
                { "text": "Ich war vorher noch nie dort gewesen.", "green": ["war", "gewesen"] },
                { "text": "Du warst schon einmal hier gewesen.", "green": ["warst", "gewesen"] },
                { "text": "Er war den ganzen Tag krank gewesen.", "green": ["war", "gewesen"] },
                { "text": "Wir waren schon weg gewesen, als du kamst.", "green": ["waren", "gewesen"] },
                { "text": "Ihr wart vorher nie im Ausland gewesen.", "green": ["wart", "gewesen"] },
                { "text": "Sie waren vor dem Spiel nervös gewesen.", "green": ["waren", "gewesen"] }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "futur1",
      "label": "Futur I",
      "sortOrder": 5,
      "note": "Future — what will be.",
      "patterns": [
        {
          "id": "futur1-how",
          "chip": "How it works",
          "subtitle": "werden + sein",
          "sortOrder": 1,
          "forms": [
            { "case": "ich", "text": "werde sein", "gloss": "I will be" },
            { "case": "du", "text": "wirst sein", "gloss": "you will be" },
            { "case": "er", "text": "wird sein", "gloss": "he / she / it will be" },
            { "case": "wir", "text": "werden sein", "gloss": "we will be" },
            { "case": "ihr", "text": "werdet sein", "gloss": "you all will be" },
            { "case": "sie", "text": "werden sein", "gloss": "they / you (formal) will be" }
          ],
          "sections": [],
          "note": "Futur I = werden + infinitive. Only werden changes for each person; the infinitive sein stays the same and goes to the end."
        },
        {
          "id": "futur1-ex",
          "chip": "Examples",
          "subtitle": "one sentence per person",
          "sortOrder": 2,
          "forms": [],
          "sections": [
            {
              "header": "Examples",
              "tone": "normal",
              "sentences": [
                { "text": "Morgen werde ich zu Hause sein.", "green": ["werde", "sein"] },
                { "text": "Du wirst bald wieder gesund sein.", "green": ["wirst", "sein"] },
                { "text": "Er wird pünktlich sein.", "green": ["wird", "sein"] },
                { "text": "Wir werden im Sommer in Italien sein.", "green": ["werden", "sein"] },
                { "text": "Ihr werdet stolz sein.", "green": ["werdet", "sein"] },
                { "text": "Sie werden zufrieden sein.", "green": ["werden", "sein"] }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "futur2",
      "label": "Futur II",
      "sortOrder": 6,
      "note": "Future perfect — what will have happened (also expresses an assumption about the past).",
      "patterns": [
        {
          "id": "futur2-how",
          "chip": "How it works",
          "subtitle": "werden + gewesen sein",
          "sortOrder": 1,
          "forms": [
            { "case": "ich", "text": "werde gewesen sein", "gloss": "I will have been" },
            { "case": "du", "text": "wirst gewesen sein", "gloss": "you will have been" },
            { "case": "er", "text": "wird gewesen sein", "gloss": "he / she / it will have been" },
            { "case": "wir", "text": "werden gewesen sein", "gloss": "we will have been" },
