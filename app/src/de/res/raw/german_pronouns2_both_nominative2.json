  "description": "Learn the subject pronouns and recognise who performs an action.",
  "intro": "Start with the subject: who or what performs the action? The nominative pronoun determines the verb ending. A nominative is also used after sein (to be) in predicate nouns.",
  "sections": [
    {
      "title": "Personal subjects and verb endings",
      "sortorder": 1,
      "explanation": "The subject is nominative. Compare the nine common subject-pronoun uses; Sie can mean she, they, or formal you, depending on capitalization and the verb/context.",
      "rule": "wer? (who?) / was? (what?) → nominative",
      "entries": [
        {
          "header": "sein",
          "kind": "conjugation",
          "explanation": "To be: the verb changes to agree with the nominative subject.",
          "pattern": "sein + nominative subject",
          "examples": [
            {
              "german": "Ich bin hier.",
              "english": "I am here.",
              "focus": "Ich",
              "note": "Nominative subject",
              "key": "Ich"
            },
            {
              "german": "Du bist hier.",
              "english": "You (singular) are here.",
              "focus": "Du",
              "note": "Nominative subject",
              "key": "Du"
            },
            {
              "german": "Er ist hier.",
              "english": "He is here.",
              "focus": "Er",
              "note": "Nominative subject",
              "key": "Er"
            },
