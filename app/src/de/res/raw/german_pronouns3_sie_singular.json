  "sheetname": "GermanPronouns3SieSingular",
  "title": "sie (she) — She",
  "description": "Practise changing the object with sie (she): present, future and past.",
  "updatedDate": 20261015,
  "intro": "Every example uses Sie as its subject, meaning she in this file. Sie here is singular she: sie sieht, sie gibt, sie wird, sie hat. It is capitalized only because it begins the sentence. Use sich when the subject is also the object or recipient. Object sie/ihr refer to another female person here; sich refers back to the subject. Keep the subject fixed and vary whom the subject sees or to whom the subject gives the book. Sehen takes an accusative object. Geben takes a dative recipient plus das Buch as the accusative thing. The highlighted key is the object or recipient. English labels: (s) singular, (p) plural, (f) formal.",
  "sections": [
    {
      "title": "sie (she) — changing the object",
      "sortorder": 1,
      "explanation": "Start with the present-tense accusative and dative lists, then compare the same object choices in Futur I and Perfekt. Short sentences omit final full stops.",
      "rule": "Sie sieht + Akkusativ | Sie gibt + Dativ + das Buch",
      "entries": [
        {
          "header": "sehen — Präsens — present",
          "kind": "pattern",
          "explanation": "The subject and verb stay fixed. Change the accusative object.",
          "pattern": "Sie sieht + Akkusativ",
          "examples": [
            {
              "german": "Sie sieht mich",
              "english": "She sees me",
              "focus": "mich",
              "note": "",
              "key": "mich"
            },
            {
              "german": "Sie sieht dich",
              "english": "She sees you (s)",
              "focus": "dich",
              "note": "",
              "key": "dich"
            },
            {
              "german": "Sie sieht ihn",
              "english": "She sees him",
              "focus": "ihn",
              "note": "",
              "key": "ihn"
            },
            {
              "german": "Sie sieht sie",
              "english": "She sees her",
              "focus": "sie",
              "note": "Singular feminine: her. A different female person from the subject; use sich for herself.",
              "key": "sie"
            },
            {
              "german": "Sie sieht es",
              "english": "She sees it",
              "focus": "es",
              "note": "",
              "key": "es"
            },
            {
              "german": "Sie sieht uns",
              "english": "She sees us",
              "focus": "uns",
              "note": "",
              "key": "uns"
            },
            {
              "german": "Sie sieht euch",
              "english": "She sees you (p)",
              "focus": "euch",
              "note": "",
              "key": "euch"
            },
            {
              "german": "Sie sieht sie",
              "english": "She sees them",
              "focus": "sie",
              "note": "Plural: them. Same German spelling as her; context distinguishes the meaning.",
              "key": "sie"
            },
            {
              "german": "Heute sieht sie Sie",
              "english": "Today she sees you (f)",
              "focus": "Sie",
              "note": "Formal object or recipient: always capitalized; one or more addressees.",
              "key": "Sie"
            },
            {
              "german": "Sie sieht sich",
              "english": "She sees herself",
              "focus": "sich",
              "note": "Reflexive reading: herself.",
              "key": "sich"
            }
          ]
        },
        {
          "header": "geben — Präsens — present",
          "kind": "pattern",
          "explanation": "The subject, verb and das Buch stay fixed. Change only the dative recipient. Ihm is translated as him here, but can also refer to a neuter noun.",
