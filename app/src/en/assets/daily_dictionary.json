          "senses": [
            {
              "senseNumber": 1,
              "definition": "a line drawn under a word or line especially for emphasis",
              "examples": [
                "Add an underscore beneath the title."
              ]
            },
            {
              "senseNumber": 2,
              "definition": "music accompanying the action and dialogue of a film",
              "examples": [
                "The film’s underscore subtly reinforced the mood."
